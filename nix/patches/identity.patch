diff --git a/contrib/emcx-wrapper.csh.in b/contrib/emcx-wrapper.csh.in
new file mode 100644
index 000000000..88674f1ac
--- /dev/null
+++ b/contrib/emcx-wrapper.csh.in
@@ -0,0 +1,23 @@
+if ($?EMCX_TMPDIR) then
+	setenv EMCX_PWD_FILE "`mktemp '$EMCX_TMPDIR/emcx.pwd.XXXXXX'`"
+else if ($?TMPDIR) then
+	setenv EMCX_PWD_FILE "`mktemp '$TMPDIR/emcx.pwd.XXXXXX'`"
+else
+	setenv EMCX_PWD_FILE "`mktemp '/tmp/emcx.pwd.XXXXXX'`"
+endif
+
+set EMCX_STATUS=0
+@bindir@/emcx -P "$EMCX_PWD_FILE" $* || set EMCX_STATUS=$?
+
+if (-r "$EMCX_PWD_FILE") then
+	setenv EMCX_PWD "`cat '$EMCX_PWD_FILE'`"
+	if ("$EMCX_PWD" != "$cwd" && -d "$EMCX_PWD") then
+		cd "$EMCX_PWD" || true
+	endif
+	unsetenv EMCX_PWD
+endif
+
+# invoke the external rm command, avoiding shell alias
+'rm' -f "$EMCX_PWD_FILE"
+unsetenv EMCX_PWD_FILE
+eval "unset EMCX_STATUS; exit $EMCX_STATUS"
diff --git a/contrib/emcx-wrapper.fish.in b/contrib/emcx-wrapper.fish.in
new file mode 100644
index 000000000..9af4765bc
--- /dev/null
+++ b/contrib/emcx-wrapper.fish.in
@@ -0,0 +1,23 @@
+set --local EMCX_PWD_FILE
+if set -q EMCX_TMPDIR
+	set EMCX_PWD_FILE (mktemp $EMCX_TMPDIR/emcx.pwd.XXXXXX)
+else if set -q TMPDIR
+	set EMCX_PWD_FILE (mktemp $TMPDIR/emcx.pwd.XXXXXX)
+else
+	set EMCX_PWD_FILE (mktemp /tmp/emcx.pwd.XXXXXX)
+end
+
+set --local EMCX_STATUS 0
+@bindir@/emcx -P "$EMCX_PWD_FILE" $argv || set EMCX_STATUS $status
+
+if test -r "$EMCX_PWD_FILE"
+	# This construct preserves internal and trailing '\n' characters.
+	read -l -z EMCX_PWD < (cat $EMCX_PWD_FILE | psub)
+	if test -n $EMCX_PWD && test $EMCX_PWD != $PWD && test -d $EMCX_PWD
+		cd $EMCX_PWD || true
+	end
+end
+
+# invoke the external rm command, avoiding shell alias or function
+command rm -f $EMCX_PWD_FILE
+exit $EMCX_STATUS
diff --git a/contrib/emcx-wrapper.sh.in b/contrib/emcx-wrapper.sh.in
new file mode 100644
index 000000000..941578d18
--- /dev/null
+++ b/contrib/emcx-wrapper.sh.in
@@ -0,0 +1,25 @@
+if test -n "$EMCX_TMPDIR"; then
+	EMCX_PWD_FILE="`mktemp "${EMCX_TMPDIR}/emcx.pwd.XXXXXX"`"
+elif test -n "$TMPDIR"; then
+	EMCX_PWD_FILE="`mktemp "${TMPDIR}/emcx.pwd.XXXXXX"`"
+else
+	EMCX_PWD_FILE="`mktemp "/tmp/emcx.pwd.XXXXXX"`"
+fi
+
+EMCX_STATUS=0
+@bindir@/emcx -P "$EMCX_PWD_FILE" "$@" || EMCX_STATUS=$?
+
+if test -r "$EMCX_PWD_FILE"; then
+	# Command substitution removes trailing '\n's, hence the added and later removed '_'.
+	EMCX_PWD="`cat "$EMCX_PWD_FILE"; printf '_'`"
+	EMCX_PWD="${EMCX_PWD%_}"
+	if test -n "$EMCX_PWD" && test "$EMCX_PWD" != "$PWD" && test -d "$EMCX_PWD"; then
+		cd "$EMCX_PWD" || true
+	fi
+	unset EMCX_PWD
+fi
+
+# invoke the external rm command, avoiding shell alias or function
+command rm -f "$EMCX_PWD_FILE"
+unset EMCX_PWD_FILE
+eval "unset EMCX_STATUS; return $EMCX_STATUS"
